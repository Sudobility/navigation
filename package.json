{
  "name": "@sudobility/navigation",
  "version": "0.0.3",
  "description": "Framework-agnostic navigation model: a screen stack and per-screen nav-bar spec (title, back, actions) shared by web and React Native view layers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "clean": "rimraf dist"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "peerDependencies": {
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/navigation.git"
  }
}
